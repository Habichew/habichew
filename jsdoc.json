{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "source": {
    "include": ["frontend/app","frontend/components","frontend/constants","frontend/context","frontend/credentials","frontend/hooks",
      "backend/config","backend/controllers","backend/models","backend/routes","backend/services"],
    "includePattern": ".+\\.(js|tsx)$",
    "excludePattern": "(node_modules/|docs)"
  },
  "plugins": ["plugins/markdown", "node_modules/jsdoc-babel"],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "babel": {
    "extensions": ["tsx"],
    "ignore": ["**/*.(test|spec).ts"],
    "babelrc": false,
    "presets": [["@babel/preset-env", { "targets": { "node": true } }], "@babel/preset-typescript"],
    "plugins": ["@babel/proposal-class-properties", "@babel/proposal-object-rest-spread"]
  },
  "opts": {
    "encoding": "utf8",
    "destination": "./docs/",
    "recurse": true,
    "verbose": true
  }
}